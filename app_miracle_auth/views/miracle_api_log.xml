<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ========================= -->
    <!-- Tree View -->
    <!-- ========================= -->
    <record id="view_miracle_api_log_list" model="ir.ui.view">
        <field name="name">miracle.api.log.list</field>
        <field name="model">miracle.api.log</field>
        <field name="arch" type="xml">
            <list string="API Logs">
                <field name="create_date"/>
                <field name="company_id"/>
                <field name="session_id"/>
                <field name="name"/>
                <field name="request_method"/>
                <field name="response_code"/>
                <field name="status"/>
            </list>
        </field>
    </record>

        <!-- ========================= -->
    <!-- Form View -->
    <!-- ========================= -->
    <record id="view_miracle_api_log_form" model="ir.ui.view">
        <field name="name">miracle.api.log.form</field>
        <field name="model">miracle.api.log</field>
        <field name="arch" type="xml">
            <form string="API Log">
                <sheet>

                    <!-- Main Information -->
                    <group>
                        <field name="company_id"/>
                        <field name="session_id"/>
                        <field name="name"/>
                        <field name="request_url"/>
                        <field name="request_method"/>
                        <field name="response_code"/>
                        <field name="status"/>
                    </group>

                    <!-- Payload Details -->
                    <notebook>
                        <page string="Request Payload">
                            <field name="request_payload" nolabel="1"/>
                        </page>

                        <page string="Response Payload">
                            <field name="response_payload" nolabel="1"/>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>


    <!-- ===================================================== -->
    <!-- SEARCH VIEW : API Logs -->
    <!-- ===================================================== -->
    <record id="view_miracle_api_log_search" model="ir.ui.view">
        <field name="name">miracle.api.log.search</field>
        <field name="model">miracle.api.log</field>
        <field name="arch" type="xml">
            <search string="Search API Logs">

                <!-- Quick Search Fields -->
                <field name="name"/>
                <field name="company_id"/>
                <field name="session_id"/>

                <!-- Filters -->
                <filter string="Success"
                        name="filter_success"
                        domain="[('status','=','success')]"/>

                <filter string="Failed"
                        name="filter_failed"
                        domain="[('status','=','failed')]"/>

                <filter string="Today"
                        name="filter_today"
                        domain="[('create_date','&gt;=',context_today())]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Company"
                            name="group_by_company"
                            context="{'group_by':'company_id'}"/>
                    <filter string="Session"
                            name="group_by_session"
                            context="{'group_by':'session_id'}"/>
                    <filter string="Status"
                            name="group_by_status"
                            context="{'group_by':'status'}"/>
                </group>

            </search>
        </field>
    </record>

    <!-- ========================= -->
    <!-- Action -->
    <!-- ========================= -->
    <record id="action_miracle_api_log" model="ir.actions.act_window">
        <field name="name">Miracle API Logs</field>
        <field name="res_model">miracle.api.log</field>
        <field name="view_mode">list,form</field>
    </record>
   
    
</odoo>