<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ===================================================== -->
    <!-- LIST VIEW : Token Sessions -->
    <!-- ===================================================== -->
    <record id="view_miracle_token_session_list" model="ir.ui.view">
        <field name="name">miracle.token.session.list</field>
        <field name="model">miracle.token.session</field>
        <field name="arch" type="xml">
            <list string="Token Sessions">
                <field name="company_id"/>
                <field name="token"/>
                <field name="generated_at"/>
                <field name="expiry_at"/>
                <field name="state"/>
                <field name="api_call_count"/>
            </list>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- FORM VIEW : Token Session -->
    <!-- ===================================================== -->
    <record id="view_miracle_token_session_form" model="ir.ui.view">
        <field name="name">miracle.token.session.form</field>
        <field name="model">miracle.token.session</field>
        <field name="arch" type="xml">
            <form string="Token Session">
                <sheet>

                    <!-- Main Information -->
                    <group>
                        <field name="company_id"/>
                        <field name="token" readonly="1"/>
                        <field name="generated_at" readonly="1"/>
                        <field name="expiry_at" readonly="1"/>
                        <field name="state"/>
                        <field name="api_call_count" readonly="1"/>
                    </group>

                    <!-- API Call Details -->
                    <notebook>
                        <page string="API Calls">
                            <field name="api_call_ids">
                                <list>
                                    <field name="create_date"/>
                                    <field name="name"/>
                                    <field name="request_method"/>
                                    <field name="response_code"/>
                                    <field name="status"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </form>
        </field>
    </record>

    <!-- ===================================================== -->
    <!-- SEARCH VIEW : Token Sessions -->
    <!-- ===================================================== -->
    <record id="view_miracle_token_session_search" model="ir.ui.view">
        <field name="name">miracle.token.session.search</field>
        <field name="model">miracle.token.session</field>
        <field name="arch" type="xml">
            <search string="Search Token Sessions">

                <!-- Quick Search Fields -->
                <field name="token"/>
                <field name="company_id"/>

                <!-- Filters -->
                <filter string="Active"
                        name="filter_active"
                        domain="[('state','=','active')]"/>

                <filter string="Expired"
                        name="filter_expired"
                        domain="[('state','=','expired')]"/>

                <!-- Group By -->
                <group expand="0" string="Group By">
                    <filter string="Company"
                            name="group_by_company"
                            context="{'group_by':'company_id'}"/>
                    <filter string="State"
                            name="group_by_state"
                            context="{'group_by':'state'}"/>
                </group>

            </search>
        </field>
    </record>

    <record id="action_miracle_token_session" model="ir.actions.act_window">
        <field name="name">Token Sessions</field>
        <field name="res_model">miracle.token.session</field>
        <field name="view_mode">list,form</field>
    </record>

   

</odoo>