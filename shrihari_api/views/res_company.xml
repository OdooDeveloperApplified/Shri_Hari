<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_shrihari_api_inherit" model="ir.ui.view">
        <field name="name">res.company.form.shrihari.api.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="app_miracle_auth.view_company_form_miracle"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='miracle_cloud_erp_config']/group" position="inside">
                <group string="Mobile App Configuration">
                    <field name="miracle_account_balance_url"/>
                    <field name="miracle_account_voucher_list_url"/>
                    <field name="miracle_generate_file_url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
