<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_miracle_voucher_inherit" model="ir.ui.view">
        <field name="name">res.company.form.miracle.voucher.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="app_miracle_auth.view_company_form_miracle"/>
        <field name="arch" type="xml">  
            <xpath expr="//page[@name='miracle_cloud_erp_config']/group" position="inside">
                <group string="Voucher Configuration">
                    <field name="miracle_post_voucher_url"/>
                    <field name="miracle_get_voucher_url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
