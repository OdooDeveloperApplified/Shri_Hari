<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_app_version_list" model="ir.ui.view">
        <field name="name">app.version.list</field>
        <field name="model">app.version</field>
        <field name="arch" type="xml">
            <list>
                <field name="android_version"/>
                <field name="ios_version"/>
            </list>
        </field>
    </record>

    <record id="view_app_version_form" model="ir.ui.view">
        <field name="name">app.version.form</field>
        <field name="model">app.version</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="android_version"/>
                        <field name="ios_version"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_app_version" model="ir.actions.act_window">
        <field name="name">App Versions</field>
        <field name="res_model">app.version</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_app_management_root"
            name="App Management"
            sequence="10"/>

    <menuitem id="menu_app_version"
              name="App Versions"
              parent="menu_app_management_root"
              action="action_app_version"
              sequence="1"/>

</odoo>