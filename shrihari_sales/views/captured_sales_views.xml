<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_captured_sales_form" model="ir.ui.view">
        <field name="name">sale.capture.form</field>
        <field name="model">sale.capture</field>
        <field name="arch" type="xml">
            <form>
                <!-- HEADER BUTTONS -->
                <header>

                    <!-- Process Order Button -->
                    <button name="action_create_sale_orders"
                            string="Create Sale Orders"
                            type="object"
                            class="btn-primary"
                            invisible="state == 'processed'"/>
        
                    <!-- Statusbar -->
                    <field name="state"
                        widget="statusbar"
                        statusbar_visible="draft,processed"/>   
                </header>
                
                <sheet>
                   <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <!-- <field name="customer_id"/> -->
                            <field name="customer_id"/>
                            <!-- Address Label -->
                            <span class="o_form_label o_td_label o_address_type">
                                <span class="fw-bold">Address</span>
                            </span>

                            <!-- Address Layout (same as res.partner) -->
                            <div class="o_address_format">
                                <field name="customer_street"
                                    placeholder="Street..."
                                    class="o_address_street"/>

                                <field name="customer_street2"
                                    placeholder="Street 2..."
                                    class="o_address_street"/>

                                <field name="customer_city"
                                    placeholder="City"
                                    class="o_address_city"/>
                                
                                <field name="customer_zip"
                                    placeholder="ZIP"
                                    class="o_address_zip"/>

                                <field name="customer_state_id"
                                    class="o_address_state"
                                    placeholder="State"
                                    options="{'no_open': True, 'no_quick_create': True}"
                                    context="{'country_id': customer_country_id, 'default_country_id': customer_country_id}"/>

                                <div class="d-flex justify-content-between">
                                    <field name="customer_country_id"
                                        placeholder="Country"
                                        class="o_address_country"
                                        options="{'no_open': True, 'no_create': True}"/>
                                </div>
                            </div>

                            <!-- Contact Info -->
                            <field name="customer_mobile"/>
                            <field name="customer_email"/>
                        </group>
                        <group>
                            <field name="user_id"/>
                            <field name="create_date" readonly="1"/>
                            <field name="sale_order_ids" widget="many2many_tags" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Sales Details">
                            <field name="line_ids" context="{'default_product_qty': 1}">
                                <list editable="bottom">
                                    <field name="currency_id" column_invisible="1"/>
                                    <field name="product_id"/>
                                    <field name="pro_category_id" readonly="1"/>
                                    <field name="product_uom_qty"/>
                                    <field name="product_uom"/>
                                    <field name="price_unit" options="{'currency_field': 'currency_id'}" widget="monetary"/>
                                    <field name="price_subtotal" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                </list>
                            </field>
                            <div>
                                <table class="table table-sm o_list_summary">
                                    <tr class="o_subtotal">
                                        <td class="text-end o_price_total">
                                            <field name="currency_id" invisible="1"/>
                                            <strong>Grand Total</strong>
                                            <field name="amount_total" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </page>
                    </notebook>
                </sheet>

                <!-- Chatter -->
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_captured_sales_tree" model="ir.ui.view">
        <field name="name">sale.capture.tree</field>
        <field name="model">sale.capture</field>
        <field name="arch" type="xml">
            <list string="Captured Sales">
                <field name="name"/>
                <field name="create_date"/>
                <field name="user_id"/>
                <field name="customer_id"/>
            </list>
        </field>
    </record>

    <record id="action_captured_sales" model="ir.actions.act_window">
        <field name="name">Captured Sales</field>
        <field name="res_model">sale.capture</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first Captured Sale
            </p>
        </field>
    </record>
    
    <menuitem id="menu_captured_sales" name="App Captured Sales"/>
    <menuitem id="menu_captured_sales_root" name="Captured Sales" parent="shrihari_sales.menu_captured_sales"/>
    <menuitem id="menu_captured_sales_records" name="View Record Details" parent="shrihari_sales.menu_captured_sales_root" action="action_captured_sales" sequence="10"/>

</odoo>
