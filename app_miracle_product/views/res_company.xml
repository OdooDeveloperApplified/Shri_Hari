<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_miracle_product_inherit" model="ir.ui.view">
        <field name="name">res.company.form.miracle.product.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="app_miracle_auth.view_company_form_miracle"/>
        <field name="arch" type="xml">  
            <xpath expr="//page[@name='miracle_cloud_erp_config']/group" position="inside">
                <group string="Product Configuration">
                    <field name="miracle_product_ledger_url"/>
                    <field name="miracle_get_product_url"/>
                    <field name="miracle_post_product_url"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
