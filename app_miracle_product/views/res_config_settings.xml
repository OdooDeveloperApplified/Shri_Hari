<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_miracle_inherit_products" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.miracle.inherit.products</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="app_miracle_auth.res_config_settings_view_form_miracle"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_generate_miracle_token']/ancestor::setting" position="after">
                <setting>
                    <div class="mt16">
                        <button name="action_get_miracle_product_ledger"
                            type="object"
                            string="Get Miracle Product Ledger"
                            class="btn btn-secondary"/>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>