<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_form_inherit_custom_page" model="ir.ui.view">
        <field name="name">product.template.form.inherit.custom.page</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <!-- Insert button for sending product to miracle -->
            <xpath expr="//header" position="inside">

                <button name="action_upload_to_miracle"
                        type="object"
                        string="Upload To Miracle"
                        class="btn-primary"
                        invisible="1"
                        />

                <button name="action_sync_from_miracle"
                        type="object"
                        string="Sync From Miracle"
                        class="btn-secondary"
                        invisible="not miracle_product_id or not is_miracle_product"/>

                <button name="action_recalculate_sale_price"
                        type="object"
                        string="Recalculate Sale Price"
                        class="btn-secondary"
                        invisible="not miracle_single_pc_rate"/>
            </xpath>

            <!-- Insert new page inside existing notebook -->
            <xpath expr="//notebook" position="inside">
                <page string="Miracle Product">
                    <group>
                        <group>
                            <field name="miracle_product_id" readonly="1"/>
                            <field name="miracle_group_id"/>
                            <field name="miracle_tax_string"/>
                            <field name="miracle_commodity_name" invisible="1"/>
                            <field name="is_miracle_product" readonly="1"/>
                        </group>
                    </group>
                </page>
            </xpath>

            <!-- Insert Miracle per-piece rate/MRP after Sale Price -->
            <xpath expr="//field[@name='list_price']/.." position="after">
                <field name="miracle_single_pc_rate" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
                <field name="miracle_mrp" widget="monetary" options="{'currency_field': 'currency_id'}" readonly="1"/>
            </xpath>

        </field>
    </record>

    <!-- Server action to add bulk sync to the Action menu in list view -->
    <record id="action_bulk_sync_miracle_server" model="ir.actions.server">
        <field name="name">Sync from Miracle</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_bulk_sync_miracle()
        </field>
    </record>

    <!-- Server action to recalculate Sale Price for selected products, locally, without calling Miracle -->
    <record id="action_recalculate_sale_price_server" model="ir.actions.server">
        <field name="name">Recalculate Sale Price (from Miracle Single PC Rate)</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            if records:
                action = records.action_recalculate_sale_price()
        </field>
    </record>

    <!-- Server action to test the stock-only Miracle ledger sync: selected
         products -> only those, no selection -> every Miracle-synced product -->
    <record id="action_sync_stock_from_miracle_ledger_server" model="ir.actions.server">
        <field name="name">Sync Stock from Miracle</field>
        <field name="model_id" ref="product.model_product_template"/>
        <field name="binding_model_id" ref="product.model_product_template"/>
        <field name="binding_view_types">list,form</field>
        <field name="state">code</field>
        <field name="code">
            action = records.action_sync_stock_from_miracle_ledger()
        </field>
    </record>

</odoo>
